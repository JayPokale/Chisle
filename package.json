{
  "name": "chisle",
  "version": "3.1.0",
  "description": "Maximum-efficiency dev mode for AI coding agents. Zero-fluff prose, YAGNI-first code, and safe tool-output compression.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "pi-package",
    "pi-coding-agent",
    "productivity",
    "yagni",
    "minimal"
  ],
  "license": "MIT",
  "author": {
    "name": "Jay Pokale",
    "url": "https://github.com/JayPokale"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "url": "https://claude.com/claude-code"
    },
    {
      "name": "Codex (OpenAI)",
      "url": "https://openai.com/codex/"
    }
  ],
  "homepage": "https://chisle.jaypokale.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayPokale/Chisle.git"
  },
  "bugs": {
    "url": "https://github.com/JayPokale/Chisle/issues"
  },
  "bin": {
    "chisle": "bin/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "pi": {
    "extensions": [
      "./pi-extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.js",
    "build:rules": "node scripts/build-rules.js",
    "check:rules": "node scripts/build-rules.js --check",
    "build:chart": "node scripts/build-chart.js",
    "check:chart": "node scripts/build-chart.js --check",
    "bench": "bash benchmarks/run-live.sh",
    "build:samples": "node scripts/build-samples.js",
    "check:samples": "node scripts/build-samples.js --check"
  },
  "files": [
    "bin/",
    "hooks/",
    "pi-extension/",
    "skills/",
    "commands/",
    "rules/",
    "AGENTS.md",
    ".cursor/",
    ".windsurf/",
    ".clinerules/",
    ".kiro/",
    ".github/copilot-instructions.md",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
