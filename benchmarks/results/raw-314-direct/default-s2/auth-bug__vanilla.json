piry time should be **rejected**\n\n# The Fix\n\nChange the comparison operator from `>` to `>=`:\n\n```javascript\n// ❌ Before (allows tokens at expiry boundary)\nif (currentTime > expiry) {\n  rejectToken();\n}\n\n// ✅ After (properly rejects at expiry boundary)\nif (currentTime >= expiry) {\n  rejectToken();\n}\n```\n\n**Why this matters:** Token expiry times define a validity window `[issuedAt, expiresAt)`. Using `>=` ensures that once the current time reaches or passes the expiry time, the token is immediately rejected — no ambiguous boundary state where an expired token is treated as valid.","ttft_ms":10040,"type":"result","duration_ms":11863,"uuid":"dfe6d363-d0c3-4b52-bd82-ec921d74d9e6","ttft_stream_ms":808,"time_to_request_ms":143,"first_content_frame_ms":808,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":1150,"cacheReadInputTokens":6912,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.0064512,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":903,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-12T05:14:51.381Z"}