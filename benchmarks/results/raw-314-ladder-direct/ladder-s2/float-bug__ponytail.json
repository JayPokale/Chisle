ken)\nlet total = 0.10 + 0.20;  // 0.30000000000000004\n\n// After (correct)\nlet totalCents = 10 + 20;  // 30\nlet display = (totalCents / 100).toFixed(2);  // \"$0.30\"\n```\n\nAdd and multiply in cents, only divide to display. If a codebase already has floats for money everywhere, the ladder says: migrate to cents schema-wide (one fix that catches all callers), not display-layer hacks like `.toFixed()` (which mask the same bug at every display site).","ttft_ms":6062,"type":"result","duration_ms":8863,"uuid":"feb10dc4-4d48-4696-a53b-83516df229b4","ttft_stream_ms":1112,"time_to_request_ms":126,"first_content_frame_ms":1113,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":674,"cacheReadInputTokens":8458,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.0042258,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":421,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-12T05:14:51.381Z"}