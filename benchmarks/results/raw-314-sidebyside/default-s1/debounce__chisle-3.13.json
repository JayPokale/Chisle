tate('');\n  const [results, setResults] = useState([]);\n\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      if (query) {\n        fetch(`/api/search?q=${encodeURIComponent(query)}`)\n          .then(res => res.json())\n          .then(data => setResults(data));\n      }\n    }, 300);\n\n    return () => clearTimeout(timer);\n  }, [query]);\n\n  return (\n    <div>\n      <input\n        value={query}\n        onChange={(e) => setQuery(e.target.value)}\n        placeholder=\"Search...\"\n      />\n      {results.map(result => <div key={result.id}>{result.name}</div>)}\n    </div>\n  );\n}\n```\n\nCleanup function cancels pending API calls when user types again. Adjust 300ms delay per UX needs.","ttft_ms":11397,"type":"result","duration_ms":13582,"uuid":"60274626-4714-4a9b-a60b-3e30bdf84b79","ttft_stream_ms":1396,"time_to_request_ms":729,"first_content_frame_ms":1396,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":1262,"cacheReadInputTokens":0,"cacheCreationInputTokens":7642,"webSearchRequests":0,"costUSD":0.021604,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":967,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7642,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-12T05:14:51.894Z"}